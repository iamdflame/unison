{
  "name": "@unison/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Unison — per-block batch auctions for tokenized assets on Monad.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./errors": {
      "development": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./tape": {
      "development": "./src/tape.ts",
      "types": "./dist/tape.d.ts",
      "import": "./dist/tape.js"
    },
    "./relayer": {
      "development": "./src/relayer.ts",
      "types": "./dist/relayer.d.ts",
      "import": "./dist/relayer.js"
    },
    "./calendar": {
      "development": "./src/calendar.ts",
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./types": {
      "development": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "abis": "node scripts/gen-abis.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@unison/engine": "workspace:*",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
