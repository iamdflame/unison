{
  "name": "@unison/tape",
  "version": "0.1.0",
  "private": true,
  "description": "Unison tape: indexes every auction print, order, fill and vault flow into SQLite and serves REST + SSE (the public trade report).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node --conditions=development src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@unison/engine": "workspace:*",
    "@unison/sdk": "workspace:*",
    "hono": "^4.13.12",
    "viem": "^2.37.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "exports": {
    ".": {
      "development": "./src/main.ts",
      "import": "./src/main.ts"
    }
  }
}
